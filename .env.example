# ---------------------------------------------------------------------------
# HOUSEHUB environment reference
#
# There is no single .env file. Each package owns one:
#
#   server/.env   -> copy server/.env.example   (required)
#   client/.env   -> copy client/.env.example   (optional, dev needs nothing)
#
# Both `.env` files are git-ignored. `.env.example` files are committed on
# purpose so a fresh clone knows exactly which variables exist.
#
# Nothing below is a real secret. Generate your own JWT_SECRET.
# ---------------------------------------------------------------------------

# ===========================================================================
# server/.env
# ===========================================================================

NODE_ENV=development
PORT=5000

# Local development database. On Atlas use mongodb+srv://<user>:<password>@<cluster>.mongodb.net/househub
MONGO_URI=mongodb://127.0.0.1:27017/househub

# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; the server refuses to boot in production without it.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins. Add your Vercel URL in production.
CLIENT_URL=http://localhost:5173

# Password hashing cost. 12 is a sensible default; drop to 4 in tests for speed.
BCRYPT_ROUNDS=12

# Rate limiting (applies to /api; the auth routes get their own, tighter budget).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# No mail provider is in the MVP stack. When true, password reset links are
# logged to the server console instead of being emailed, which makes the whole
# reset flow testable locally.
EMAIL_DEV_MODE=true

# Optional. Receipt and avatar uploads stay disabled until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default weekly house chore goal used when a house has not set its own.
WEEKLY_CHORE_GOAL=50

# ===========================================================================
# client/.env
# ===========================================================================

# Leave UNSET in development: vite.config.js proxies /api to localhost:5000,
# so there is no CORS preflight and no absolute URL to keep in sync.
#
# In production (Vercel) set this to the deployed API root, INCLUDING /api.
VITE_API_URL=https://your-api.onrender.com/api
