# ---------------------------------------------------------------------------
# HOUSEHUB backend environment
# Copy this file to server/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Local dev database. For Atlas use:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/househub
MONGO_URI=mongodb://127.0.0.1:27017/househub

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. The server refuses to boot in production without it.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins (CORS).
CLIENT_URL=http://localhost:5173

BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# No mail provider is wired up in the MVP. When true, password reset links are
# written to the server console instead of being emailed.
EMAIL_DEV_MODE=true

# Optional - receipt uploads stay disabled until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weekly house chore goal shown on the dashboard.
WEEKLY_CHORE_GOAL=50
