# Copy to .env for local overrides.
# Leave this UNSET in development: vite.config.js proxies /api to localhost:5000,
# which avoids CORS entirely and keeps the cookie/bearer story simple.
#
# In production (Vercel) set this to the deployed API root, INCLUDING /api:
VITE_API_URL=https://househub-api.onrender.com/api
